+/* Low-power mute. Muted: mask WAKE and drop the mic into its
+ * hardware AAD sleep now (PDM off, SD rail off when nothing is connected) instead
+ * of capturing frames that mic_handler() would throw away. Unmuted: wake it; the
+ * normal silence timer takes over again. Non-blocking; the aad thread does the work. */
+void mic_set_muted(bool muted)
+{
+    atomic_set(&aad_muted, muted ? 1 : 0);
+    if (muted) {
+        aad_wake_irq(false);
+        atomic_set(&aad_req_sleep, 1);
+    } else {
+        atomic_set(&aad_wake_pending, 1);
+    }
+    k_sem_give(&aad_sem);
+}
